{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build codec for debugging",
            "type": "shell",
            "command": "mkdir -p debug/can/codec && gcc -g -O0 -fno-omit-frame-pointer -Wall -Wextra src/can/codec/*.c -lm -o debug/can/codec/codec",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build send_can for debugging",
            "type": "shell",
            "command": "mkdir -p debug/can/send_can && gcc -g -O0 -fno-omit-frame-pointer -Wall -Wextra src/can/send_can.c src/can/utils.c src/can/msg/test_u64/test_u64.c src/logger/logger.c -o debug/can/send_can/send_can",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        }
    ]
}
